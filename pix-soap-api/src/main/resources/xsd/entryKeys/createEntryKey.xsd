<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://pix.com/soap/contract"
           targetNamespace="http://pix.com/soap/contract"
           elementFormDefault="qualified">

    <xs:include schemaLocation="../generics/commonsType.xsd"/>

    <xs:element name="CreateEntryKeyRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Signature" type="xs:string" minOccurs="0"/>
                <xs:element name="Entry" type="tns:EntryType"/>
                <xs:element name="Reason" type="tns:ReasonType"/>
                <xs:element name="RequestId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CreateEntryKeyResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="tns:ResponseCommon"/>
                <xs:element name="Entry" type="tns:EntryResponseType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="EntryResponseType">
        <xs:complexContent>
            <xs:extension base="tns:EntryType">
                <xs:sequence>
                    <xs:element name="CreationDate" type="xs:dateTime"/>
                    <xs:element name="KeyOwnershipDate" type="xs:dateTime"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="EntryType">
        <xs:sequence>
            <xs:element name="Key" type="xs:string"/>
            <xs:element name="KeyType" type="tns:KeyType"/>
            <xs:element name="Account" type="tns:AccountType"/>
            <xs:element name="Owner" type="tns:OwnerType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="ReasonType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ACCOUNT_CLOSURE"/>
            <xs:enumeration value="BRANCH_TRANSFER"/>
            <xs:enumeration value="FRAUD"/>
            <xs:enumeration value="PARTICIPANT_EXCLUSION"/>
            <xs:enumeration value="RFB_VALIDATION"/>
            <xs:enumeration value="RECONCILIATION"/>
            <xs:enumeration value="USER_REQUESTED"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
